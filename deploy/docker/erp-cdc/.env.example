# Copy to .env on the target server and chmod 600 .env.
# Never commit the real .env file.

COMPOSE_PROJECT_NAME=erp-cdc
BIND_IP=127.0.0.1
TZ=Asia/Shanghai

DINKY_IMAGE=ghcr.io/yezh1i/dinky-standalone-server@sha256:0472f5b63d456244fc92a04bba79ef617f9fa18151bcc6e04168a67818332b02
STARROCKS_FE_IMAGE=starrocks/fe-ubuntu@sha256:fad7faecc3cf6ae55b4d150cd51769a3e2e2ba1c5a6a75c8c844d828f72f27ae
STARROCKS_BE_IMAGE=starrocks/be-ubuntu@sha256:ba115c16331a2500085f7b3493e9d883d89c191f70fbf02e8db59d30b4185688
MYSQL_IMAGE=mysql@sha256:a532724022429812ec797c285c1b540a644c15e248579c6bfdf12a8fbaab4964

DINKY_DATA_ROOT=/opt/dinky-data
STARROCKS_DATA_ROOT=/data/starrocks
DINKY_DB_ROOT=/data/dinky-mysql

DINKY_DB_NAME=dinky
DINKY_DB_USER=dinky
DINKY_DB_PASSWORD=replace-with-a-long-random-password
DINKY_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

DINKY_JVM_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC
